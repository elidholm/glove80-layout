+ */
+
+#pragma once
+
+#include <zephyr/devicetree.h>
+#include <stdint.h>
+#include <stdbool.h>
+
+#if DT_HAS_COMPAT_STATUS_OKAY(zmk_behavior_underglow_modifiers)
