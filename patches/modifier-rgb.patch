diff --git a/app/src/behaviors/behavior_underglow_modifiers.c b/app/src/behaviors/behavior_underglow_modifiers.c
new file mode 100644
index 0000000..9c13733
--- /dev/null
+++ b/app/src/behaviors/behavior_underglow_modifiers.c
@@ -0,0 +1,177 @@
+/*
+ * SPDX-License-Identifier: MIT
+ */
+
+#define DT_DRV_COMPAT zmk_behavior_underglow_modifiers
+
+#include <zephyr/device.h>
+#include <zephyr/sys/atomic.h>
+#include <zephyr/logging/log.h>
+#include <drivers/behavior.h>
+#include <zmk/behavior.h>
+#include <zmk/event_manager.h>
+#include <zmk/events/underglow_color_changed.h>
+#include <zmk/rgb_modifiers.h>
+#include <zmk/keymap.h>
+#include <zmk/matrix.h>
+#include <zmk/events/layer_state_changed.h>
+#include <zmk/workqueue.h>
+
+#if IS_ENABLED(CONFIG_ZMK_SPLIT_BLE)
+#include <zmk/split/bluetooth/service.h>
+#endif
+
+LOG_MODULE_DECLARE(zmk, CONFIG_ZMK_LOG_LEVEL);
+
+#if DT_HAS_COMPAT_STATUS_OKAY(DT_DRV_COMPAT)
+
+#if IS_ENABLED(CONFIG_ZMK_SPLIT_BLE)
+BUILD_ASSERT(sizeof(DEVICE_DT_NAME(DT_NODELABEL(ug_mod_sync))) <= ZMK_SPLIT_RUN_BEHAVIOR_DEV_LEN,
+             "RGB sync behavior name exceeds the split Bluetooth payload");
+#endif
+
+#if IS_ENABLED(CONFIG_ZMK_SPLIT) && !IS_ENABLED(CONFIG_ZMK_SPLIT_ROLE_CENTRAL)
+#include <zmk/events/split_peripheral_status_changed.h>
+#endif
+
+static atomic_t active_modifiers;
+
+struct underglow_modifiers_config {
+    uint8_t mods;
+};
+
+static void refresh_colors(struct k_work *work) {
+    raise_zmk_underglow_color_changed(
+        (struct zmk_underglow_color_changed){.layers = UINT32_MAX, .wakeup = true});
+}
+
+K_WORK_DEFINE(refresh_work, refresh_colors);
+
+static void apply_snapshot(uint8_t modifiers) {
+    if (atomic_set(&active_modifiers, modifiers) != modifiers) {
+        LOG_DBG("RGB modifiers: 0x%02x", modifiers);
+        k_work_submit_to_queue(zmk_workqueue_lowprio_work_q(), &refresh_work);
+    }
+}
+
+static int sync_pressed(struct zmk_behavior_binding *binding,
+                        struct zmk_behavior_binding_event event) {
+    apply_snapshot(binding->param1);
+    return 0;
+}
+
+static const struct behavior_driver_api sync_api = {
+    .binding_pressed = sync_pressed,
+    .locality = BEHAVIOR_LOCALITY_GLOBAL,
+};
+
+BEHAVIOR_DT_DEFINE(DT_NODELABEL(ug_mod_sync), NULL, NULL, NULL, NULL, POST_KERNEL,
+                   CONFIG_KERNEL_INIT_PRIORITY_DEFAULT, &sync_api);
+
+#if !IS_ENABLED(CONFIG_ZMK_SPLIT) || IS_ENABLED(CONFIG_ZMK_SPLIT_ROLE_CENTRAL)
+
+static atomic_t pending_modifiers;
+ATOMIC_DEFINE(pressed_positions, ZMK_KEYMAP_LEN);
+
+#define POSITION_MASK(node, prop, idx) \
+    [DT_PROP_BY_IDX(node, prop, idx)] = DT_PROP(node, mods),
+#define GROUP_POSITIONS(n) DT_FOREACH_PROP_ELEM(DT_DRV_INST(n), key_positions, POSITION_MASK)
+static const uint8_t position_masks[ZMK_KEYMAP_LEN] = {
+    DT_INST_FOREACH_STATUS_OKAY(GROUP_POSITIONS)
+};
+
+static uint8_t physical_modifiers(void) {
+    uint8_t modifiers = 0;
+    if (zmk_keymap_highest_layer_active() == 0) {
+        for (int position = 0; position < ZMK_KEYMAP_LEN; position++) {
+            if (atomic_test_bit(pressed_positions, position)) {
+                modifiers |= position_masks[position];
+            }
+        }
+    }
+    return modifiers;
+}
+
+static void publish_snapshot(struct k_work *work) {
+    struct zmk_behavior_binding binding = {
+        .behavior_dev = DEVICE_DT_NAME(DT_NODELABEL(ug_mod_sync)),
+        .param1 = atomic_get(&pending_modifiers),
+    };
+    struct zmk_behavior_binding_event event = {.timestamp = k_uptime_get()};
+    zmk_behavior_invoke_binding(&binding, event, true);
+}
+
+K_WORK_DEFINE(publish_work, publish_snapshot);
+
+static void update_modifiers(void) {
+    uint8_t modifiers = physical_modifiers();
+    if (atomic_set(&pending_modifiers, modifiers) != modifiers) {
+        k_work_submit(&publish_work);
+    }
+}
+
+void zmk_rgb_modifiers_position_changed(uint32_t position, bool pressed) {
+    if (position < ZMK_KEYMAP_LEN && position_masks[position]) {
+        atomic_set_bit_to(pressed_positions, position, pressed);
+        update_modifiers();
+    }
+}
+
+void zmk_rgb_modifiers_resync(void) {
+    atomic_set(&pending_modifiers, physical_modifiers());
+    k_work_submit(&publish_work);
+}
+
+static int layer_changed(const zmk_event_t *eh) {
+    update_modifiers();
+    return ZMK_EV_EVENT_BUBBLE;
+}
+
+ZMK_LISTENER(rgb_modifiers, layer_changed);
+ZMK_SUBSCRIPTION(rgb_modifiers, zmk_layer_state_changed);
+
+#else
+
+void zmk_rgb_modifiers_position_changed(uint32_t position, bool pressed) {}
+
+static int peripheral_status_changed(const zmk_event_t *eh) {
+    const struct zmk_split_peripheral_status_changed *ev =
+        as_zmk_split_peripheral_status_changed(eh);
+    if (!ev->connected) {
+        apply_snapshot(0);
+    }
+    return ZMK_EV_EVENT_BUBBLE;
+}
+
+ZMK_LISTENER(rgb_modifiers, peripheral_status_changed);
+ZMK_SUBSCRIPTION(rgb_modifiers, zmk_split_peripheral_status_changed);
+
+#endif
+
+static int modifier_color(struct zmk_behavior_binding *binding,
+                          struct zmk_behavior_binding_event event) {
+    const struct device *dev = zmk_behavior_get_binding(binding->behavior_dev);
+    const struct underglow_modifiers_config *config = dev->config;
+    int color = (atomic_get(&active_modifiers) & config->mods) ? binding->param2 : binding->param1;
+    LOG_DBG("RGB group 0x%02x: 0x%06x", config->mods, color);
+    return color;
+}
+
+static int color_released(struct zmk_behavior_binding *binding,
+                          struct zmk_behavior_binding_event event) {
+    return 0;
+}
+
+static const struct behavior_driver_api color_api = {
+    .binding_pressed = modifier_color,
+    .binding_released = color_released,
+};
+
+#define MOD_INST(n)                                                                                 \
+    static const struct underglow_modifiers_config config_##n = {.mods = DT_INST_PROP(n, mods)};    \
+    BEHAVIOR_DT_INST_DEFINE(n, NULL, NULL, NULL, &config_##n, POST_KERNEL,                           \
+                            CONFIG_KERNEL_INIT_PRIORITY_DEFAULT, &color_api);
+
+DT_INST_FOREACH_STATUS_OKAY(MOD_INST)
+
+#endif
