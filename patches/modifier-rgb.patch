new file mode 100644
index 0000000..488b039
--- /dev/null
+++ b/app/tests/modifiers/rgb-renderer/mock/led_strip.c
@@ -0,0 +1,182 @@
+#include <stdlib.h>
+#include <zephyr/device.h>
+#include <zephyr/drivers/led_strip.h>
+#include <zephyr/kernel.h>
+#include <zephyr/logging/log.h>
+#include <drivers/behavior.h>
+#include <zmk/behavior.h>
+#include <zmk/events/position_state_changed.h>
+#include <zmk/hid.h>
+#include <zmk/keymap.h>
+#include <zmk/rgb_modifiers.h>
+#include <zmk/rgb_underglow.h>
+#include <zmk/rgb_underglow_layer.h>
+#include <zmk/split/bluetooth/service.h>
+
+LOG_MODULE_DECLARE(zmk, CONFIG_ZMK_LOG_LEVEL);
+
+static struct led_rgb frame[40];
+
+static int update_rgb(const struct device *dev, struct led_rgb *pixels, size_t count) {
+    __ASSERT(count == ARRAY_SIZE(frame), "Unexpected strip size");
+    memcpy(frame, pixels, sizeof(frame));
+    return 0;
+}
+
+static const struct led_strip_driver_api api = {.update_rgb = update_rgb};
+
+DEVICE_DT_DEFINE(DT_NODELABEL(test_led), NULL, NULL, NULL, NULL, POST_KERNEL,
+                 CONFIG_KERNEL_INIT_PRIORITY_DEVICE, &api);
+
+enum { SHIFT = BIT(0), CTRL = BIT(1), ALT = BIT(2), ALTGR = BIT(3), GROUP_GUI = BIT(4) };
+
+static void check_frame(const char *name, uint8_t groups) {
+    k_sleep(K_MSEC(30));
+    for (int pixel = 0; pixel < ARRAY_SIZE(frame); pixel++) {
+        int position = rgb_pixel_lookup(pixel);
+        uint32_t color = 0;
+        if ((groups & SHIFT) && (position == 38 || position == 41 || position == 52 || position == 57)) {
+            color = 0x00FFFF;
+        } else if ((groups & CTRL) && (position == 37 || position == 42 || position == 53 || position == 56)) {
+            color = 0x00FF00;
+        } else if ((groups & ALT) && (position == 36 || position == 71)) {
+            color = 0xFF8000;
+        } else if ((groups & ALTGR) && (position == 43 || position == 72)) {
+            color = 0xFF00FF;
+        } else if ((groups & GROUP_GUI) && (position == 35 || position == 44 || position == 55)) {
+            color = 0xFFFF00;
+        }
+        struct led_rgb expected = {
+            .r = ((color >> 16) & 0xFF) * 100 / 255,
+            .g = ((color >> 8) & 0xFF) * 100 / 255,
+            .b = (color & 0xFF) * 100 / 255,
+        };
+        if (memcmp(&frame[pixel], &expected, sizeof(expected))) {
+            LOG_ERR("%s: position %d: got %02x%02x%02x expected %02x%02x%02x", name, position,
+                    frame[pixel].r, frame[pixel].g, frame[pixel].b,
+                    expected.r, expected.g, expected.b);
+            exit(1);
+        }
+    }
+    LOG_INF("RGB check: %s", name);
+}
+
+static void position(uint32_t key, bool pressed) {
+    raise_zmk_position_state_changed((struct zmk_position_state_changed){
+        .position = key, .state = pressed,
+        .source = ZMK_POSITION_STATE_CHANGE_SOURCE_LOCAL, .timestamp = k_uptime_get(),
+    });
+}
+
+static void run_tests(void *a, void *b, void *c) {
+    k_sleep(K_MSEC(50));
+    zmk_rgb_underglow_select_effect(4);
+    zmk_rgb_underglow_on();
+
+    /* Exercise the actual Bluetooth payload limit and receiving behavior lookup. */
+    struct zmk_split_run_behavior_payload payload = {0};
+    const char *name = DEVICE_DT_NAME(DT_NODELABEL(ug_mod_sync));
+    __ASSERT(strlcpy(payload.behavior_dev, name, sizeof(payload.behavior_dev)) < sizeof(payload.behavior_dev),
+             "Split behavior name truncated");
+    const struct device *receiver = zmk_behavior_get_binding(payload.behavior_dev);
+    __ASSERT(receiver != NULL, "Peripheral cannot resolve sync behavior");
+    payload.data.param1 = 0xFF;
+    struct zmk_behavior_binding binding = {
+        .behavior_dev = payload.behavior_dev, .param1 = payload.data.param1,
+    };
+    behavior_keymap_binding_pressed(&binding, (struct zmk_behavior_binding_event){0});
+    check_frame("split snapshot all groups", SHIFT | CTRL | ALT | ALTGR | GROUP_GUI);
+    binding.param1 = 0;
+    behavior_keymap_binding_pressed(&binding, (struct zmk_behavior_binding_event){0});
+    check_frame("split snapshot cleared", 0);
+
+    const uint8_t keys[] = {38, 41, 52, 57, 37, 42, 36, 43, 35, 44, 55};
+    const uint8_t groups[] = {SHIFT, SHIFT, SHIFT, SHIFT, CTRL, CTRL, ALT, ALTGR, GROUP_GUI, GROUP_GUI, GROUP_GUI};
+    for (int i = 0; i < ARRAY_SIZE(keys); i++) {
+        position(keys[i], true);
+        check_frame("individual physical key pressed", groups[i]);
+        position(keys[i], false);
+        check_frame("individual physical key released", 0);
+    }
+
+    position(41, true);
+    check_frame("J lights before hold resolution", SHIFT);
+    __ASSERT(zmk_hid_get_explicit_mods() == 0, "Home-row hold resolved too soon");
+    position(37, true);
+    check_frame("J and D combine before hold resolution", SHIFT | CTRL);
+    position(41, false);
+    check_frame("release J leaves Ctrl", CTRL);
+    position(37, false);
+    check_frame("release D clears remaining group", 0);
+
+    position(41, true);
+    position(37, true);
+    position(36, true);
+    position(43, true);
+    position(35, true);
+    check_frame("all five physical groups combine", SHIFT | CTRL | ALT | ALTGR | GROUP_GUI);
+    position(37, false);
+    check_frame("release Ctrl preserves four groups", SHIFT | ALT | ALTGR | GROUP_GUI);
+    position(35, false);
+    position(43, false);
+    position(36, false);
+    position(41, false);
+    check_frame("all five groups released", 0);
+
+    position(52, true);
+    position(57, true);
+    check_frame("both thumb Shifts", SHIFT);
+    position(52, false);
+    check_frame("right Shift survives left release", SHIFT);
+    position(57, false);
+    check_frame("both Shifts released", 0);
+    position(52, true);
+    position(57, true);
+    position(57, false);
+    check_frame("left Shift survives right release", SHIFT);
+    position(52, false);
+    check_frame("reverse release clears Shift", 0);
+
+    position(0, true);
+    check_frame("implicit Shift from unlisted key ignored", 0);
+    position(0, false);
+    position(52, true);
+    check_frame("Shift before layer change", SHIFT);
+    zmk_keymap_layer_activate(1);
+    check_frame("higher layer suppresses indication", 0);
+    position(43, true);
+    check_frame("AltGr pressed outside Base stays dark", 0);
+    position(52, false);
+    zmk_keymap_layer_deactivate(1);
+    check_frame("return to Base shows still-held AltGr only", ALTGR);
+    position(43, false);
+    check_frame("release after layer change", 0);
+
+    position(52, true);
+    check_frame("Shift before RGB off", SHIFT);
+    zmk_rgb_underglow_off();
+    zmk_rgb_underglow_on();
+    check_frame("queued off cannot erase re-enabled Shift", SHIFT);
+    zmk_rgb_underglow_off();
+    position(37, true);
+    check_frame("physical changes respect RGB off", 0);
+    zmk_rgb_underglow_on();
+    check_frame("RGB on restores held groups", SHIFT | CTRL);
+    position(52, false);
+    position(37, false);
+    check_frame("release after RGB on", 0);
+    zmk_rgb_modifiers_resync();
+    check_frame("resync preserves current state", 0);
+    position(52, true);
+    check_frame("held Shift before receiver reset", SHIFT);
+    binding.param1 = 0;
+    behavior_keymap_binding_pressed(&binding, (struct zmk_behavior_binding_event){0});
+    check_frame("receiver snapshot cleared", 0);
+    zmk_rgb_modifiers_resync();
+    check_frame("resync restores unchanged held snapshot", SHIFT);
+    position(52, false);
+    check_frame("release after resync", 0);
+    exit(0);
+}
+
+K_THREAD_DEFINE(rgb_test_thread, 4096, run_tests, NULL, NULL, NULL, 5, 0, 0);
