+
+/delete-node/ &ug_b2;
+/delete-node/ &ug_b4;
+/delete-node/ &ug_b6;
+/delete-node/ &ug_b8;
+
+/ {
+    chosen {
+        zmk,underglow = &test_led;
+    };
+    test_gpio: gpio@0 {
+        compatible = "zephyr,gpio-emul";
+        reg = <0 4>;
+        gpio-controller;
+        #gpio-cells = <2>;
+        ngpios = <1>;
+    };
+    ext_power {
+        compatible = "zmk,ext-power-generic";
+        control-gpios = <&test_gpio 0 GPIO_ACTIVE_HIGH>;
+        init-delay-ms = <0>;
+    };
+    test_led: test_led {
+        compatible = "test,rgb-strip";
+        chain-length = <2>;
+    };
+    behaviors {
+        test_shift: test_shift {
+            compatible = "zmk,behavior-underglow-modifiers";
+            #binding-cells = <2>;
+            mods = <(MOD_LSFT | MOD_RSFT)>;
+        };
+        test_altgr: test_altgr {
+            compatible = "zmk,behavior-underglow-modifiers";
+            #binding-cells = <2>;
+            mods = <MOD_RALT>;
+        };
+        test_morph: test_morph {
+            compatible = "zmk,behavior-mod-morph";
+            #binding-cells = <0>;
+            bindings = <&kp A>, <&kp B>;
+            mods = <MOD_LSFT>;
+        };
+    };
+    keymap {
+        compatible = "zmk,keymap";
+        base {
+            bindings = <
+                &kp LSHFT &kp RALT &rgb_ug RGB_EFS_CMD 4 &rgb_ug RGB_TOG
+                &kp LS(A) &test_morph &mo 1 &none
+            >;
+        };
+        higher {
+            bindings = <
+                &trans &trans &trans &trans
+                &trans &trans &trans &trans
+            >;
+        };
+    };
+    underglow-layer {
+        compatible = "zmk,underglow-layer";
+        pixel-lookup = <0 1>;
+        base {
+            layer-id = <0>;
+            fade-delay = <(-1)>;
+            bindings = <
+                &test_shift 0 0x00FFFF &test_altgr 0 0xFF00FF &ug 0 &ug 0
+                &ug 0 &ug 0 &ug 0 &ug 0
+            >;
+        };
+        higher {
+            layer-id = <1>;
+            fade-delay = <(-1)>;
+            bindings = <
+                &test_shift 0 0x00FFFF &test_altgr 0 0xFF00FF &ug 0 &ug 0
+                &ug 0 &ug 0 &ug 0 &ug 0
+            >;
+        };
+    };
+};
+
+&kscan {
+    rows = <2>;
+    columns = <4>;
+    events = <
+        ZMK_MOCK_PRESS(0,2,30) ZMK_MOCK_RELEASE(0,2,30)
+        ZMK_MOCK_PRESS(0,0,30)
+        ZMK_MOCK_PRESS(0,3,30) ZMK_MOCK_RELEASE(0,3,30)
+        ZMK_MOCK_PRESS(0,1,30)
+        ZMK_MOCK_RELEASE(0,0,30)
+        ZMK_MOCK_PRESS(0,3,30) ZMK_MOCK_RELEASE(0,3,30)
+        ZMK_MOCK_RELEASE(0,1,30)
+        ZMK_MOCK_PRESS(1,0,30) ZMK_MOCK_RELEASE(1,0,30)
+        ZMK_MOCK_PRESS(0,0,30)
+        ZMK_MOCK_PRESS(1,1,30) ZMK_MOCK_RELEASE(1,1,30)
+        ZMK_MOCK_RELEASE(0,0,30)
+        ZMK_MOCK_PRESS(1,2,30)
+        ZMK_MOCK_PRESS(0,1,30) ZMK_MOCK_RELEASE(0,1,30)
+        ZMK_MOCK_RELEASE(1,2,30)
+    >;
+};
